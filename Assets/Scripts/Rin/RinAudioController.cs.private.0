using UnityEngine;
using System.Collections.Generic;
using Kogetsu.Library.DesignPatternCore;

/// <summary>
/// ผูกเสียงพากย์ 1 line เข้ากับคลิปเสียง (ใส่ได้หลายคลิป → สุ่มเล่น)
/// </summary>
[System.Serializable]
public class VoiceLineSound
{
    [Tooltip("ชื่อเหตุการณ์ ตรงกับ PlayerVoiceLine ที่ฝั่ง publisher ส่งมา")]
    public PlayerVoiceLine EventName;

    [Tooltip("คลิปเสียงของ line นี้ ถ้าใส่หลายคลิปจะสุ่มเล่น 1 อัน")]
    public List<AudioClip> Sound = new();
}

/// <summary>
/// เล่นเสียงพากย์ผู้เล่น (Rin) เมื่อได้รับ EventNameAndTag ที่มี Tag == PlayerVoice.Tag
/// ลากคลิปเสียงใส่ใน _voiceLines ตามแต่ล่ะ EventName ได้เลยใน Inspector
/// </summary>
public class RinAudioController : MonoBehaviour
{
    [Tooltip("ตารางจับคู่ เหตุการณ์ → คลิปเสียง")]
    [SerializeField] private List<VoiceLineSound> _voiceLines = new();

    [Tooltip("AudioSource สำหรับเสียงพากย์")]
    [SerializeField] private AudioSource _audioSource;

    [Tooltip("เล่นทับเสียงพากย์เดิมที่ยังเล่นค้างอยู่หรือไม่ (false = รอให้จบก่อน)")]
    [SerializeField] private bool _interruptCurrent = false;

    private Dictionary<PlayerVoiceLine, List<AudioClip>> _soundDictionary = new();

    private void Awake()
    {
        foreach (var entry in _voiceLines)
        {
            if (entry == null) continue;

            if (!_soundDictionary.ContainsKey(entry.EventName))
            {
                _soundDictionary[entry.EventName] = new List<AudioClip>(entry.Sound);
            }
            else
            {
                Debug.LogWarning($"<color=#00FF88>[RinAudioController]</color> EventName '{entry.EventName}' ซ้ำ — ใช้ตัวแรกเท่านั้น");
            }
        }
    }

    private void OnEnable()
    {
        if (EventBus.Instance)
            EventBus.Instance.Subscribe<EventNameAndTag>(OnPlayerSound);
    }

    private void OnDisable()
    {
        if (EventBus.Instance)
            EventBus.Instance.Unsubscribe<EventNameAndTag>(OnPlayerSound);
    }

    private void OnPlayerSound(EventNameAndTag data)
    {
        // กรองเฉพาะเสียงพากย์ผู้เล่น
        if (data.Tag != PlayerVoice.Tag) return;

        if (!System.Enum.TryParse(data.Name, out PlayerVoiceLine line)) return;

        if (!_soundDictionary.TryGetValue(line, out List<AudioClip> sounds) || sounds.Count == 0)
        {
            Debug.LogWarning($"<color=#00FF88>[RinAudioController]</color> ไม่มีคลิปเสียงสำหรับ '{line}'");
            return;
        }

        // ถ้ายังเล่นค้างอยู่และไม่อนุญาตให้ทับ ก็ข้าม (ปล่อยคลิปเดิมเล่นจนจบ)
        if (!_interruptCurrent && _audioSource.isPlaying) return;

        AudioClip clip = sounds[Random.Range(0, sounds.Count)];

        if (_interruptCurrent)
            _audioSource.Stop();

        _audioSource.PlayOneShot(clip);
    }
}
